[{"name":"evaluate_script","_url":"http://127.0.0.1:8765/index.html?index2-audit-original","arguments":{"function":"() => {const art=document.querySelector('section[data-section=\"19\"] .section-art');const inv=art.getScreenCTM().inverse();return [...art.querySelectorAll('g[id=\"Frame 16\"] > g,g[id=\"Frame 16\"] > a > g')].map((g,i)=>{const b=g.getBBox(),m=inv.multiply(g.getScreenCTM());return {id:'video-'+i,section:'19',rect:{x:b.x*m.a+m.e,y:b.y*m.d+m.f,width:b.width*m.a,height:b.height*m.d},texts:[...g.querySelectorAll('text')].map(t=>t.id)};});}"}}]
